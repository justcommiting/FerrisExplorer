{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FerrisExplorer",
  "version": "0.3.2",
  "identifier": "dev.ferrisexplorer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyRkY0QTIzNDlDOEQ3OTYKUldTVzE4aEpJMHIvRXIwbTdtK2Q5UFJEZmRVaDdDVHVkOUNGOWU4bjhwTGt2NEc4WGx6WUVtZU0K",
      "endpoints": [
        "https://github.com/justcommiting/FerrisExplorer-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
